# Supabase — proyecto en https://supabase.com/dashboard
# Settings > API. Copia este fichero a .env y rellena los valores.
#
#   cp .env.example .env
#
# La ANON key es publica por diseno (va en el bundle del navegador): la
# proteccion real son las politicas RLS de las tablas, no ocultar la clave.
# La SERVICE_ROLE key NO debe aparecer nunca aqui ni en ningun VITE_*.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
